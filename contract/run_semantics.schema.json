{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qlheric.github.io/agent-run-semantics-contract/v0.5.0/run_semantics.schema.json",
  "title": "Agent Run 语义契约 v0.5.0",
  "description": "M1 Agent Run 控制面语义契约 v0.5.0（单一真源）。本文只定形状，不定实现。",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[A-Za-z0-9_.-]+$": { "$ref": "#/$defs/json_value" }
  },
  "required": ["spec", "run", "step"],
  "properties": {
    "$comment": {
      "type": "string",
      "description": "fixture 用途说明（可选注解，不参与语义）"
    },
    "extensions": {
      "$ref": "#/$defs/extensions",
      "description": "逃生舱：自由扩展容器（字段名与值都不限；不参与语义、不参与哈希）"
    },
    "spec": { "$ref": "#/$defs/spec" },
    "run": { "$ref": "#/$defs/run" },
    "step": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" },
      "minItems": 1,
      "description": "run 的步骤序列（v0.3 起是数组；v0.2 的单对象形状已废弃）"
    },
    "x-status-transitions": {
      "$ref": "#/$defs/status_transitions",
      "description": "契约级状态转移表（文档根元数据，不随每份 run 快照重复下发）。**可省略**：唯一权威是 contract/status-transitions.json；若带则必须与权威表逐状态逐目标相等（纪律④）"
    }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "clock", "framework"],
      "properties": {
        "version": {
          "type": "string",
          "enum": ["0.2.0", "0.3.0", "0.4.0", "0.5.0"],
          "description": "契约版本；版本变了还是同一契约（ID 永不重命名）。v0.3 起改为**版本集合**（不再 const），新增版本只改这一处"
        },
        "clock": {
          "$ref": "#/$defs/clock",
          "description": "契约级时钟约定：时间注入点（字段 17）"
        },
        "framework": {
          "type": "string",
          "minLength": 1,
          "description": "执行面框架标识（**自由字符串**，不设枚举：框架清单会变，枚举会把消费方钉死；只做形状，不做优劣评价）"
        }
      }
    },
    "clock": {
      "type": "string",
      "enum": ["wall", "monotonic"],
      "description": "wall=绝对墙钟；monotonic=本地单调钟（只计时不宣布超时）"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "status",
        "clock",
        "idempotency_key",
        "policy",
        "budget",
        "termination",
        "error",
        "side_effect_unknown",
        "audit",
        "tools",
        "reservations"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "running",
            "waiting_approval",
            "paused",
            "degraded",
            "succeeded",
            "failed",
            "cancelled",
            "outcome_unknown"
          ],
          "description": "run 状态（字段 2）；outcome_unknown = 副作用可能已发生"
        },
        "clock": {
          "$ref": "#/$defs/clock",
          "description": "run 级时钟约定（字段 17）"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "description": "run 级**业务幂等键**（语义 1）：同键重放 ⇒ 同一 run。映射 IETF Idempotency-Key（消费方可把它放进 HTTP 头）。幂等键优先级：run.idempotency_key > step.dedupe_scope > tools[].dedupe_key_template"
        },
        "policy": { "$ref": "#/$defs/policy" },
        "budget": { "$ref": "#/$defs/budget" },
        "termination": { "$ref": "#/$defs/termination" },
        "error": {
          "description": "run 级错误；**无错时显式为 null**（不再用 code=\"none\" 哨兵）",
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/error" }
          ]
        },
        "side_effect_unknown": {
          "type": "boolean",
          "description": "副作用是否处于**未知**状态（outcome_unknown 的读侧事实）：status=outcome_unknown ⇔ side_effect_unknown=true；其余状态恒为 false"
        },
        "audit": {
          "type": "array",
          "items": { "$ref": "#/$defs/audit_entry" },
          "description": "审计链条目（字段 9）：append-only 哈希链"
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool_entry" },
          "description": "按档过滤后下发的工具目录（字段 10）"
        },
        "reservations": {
          "type": "array",
          "items": { "$ref": "#/$defs/reservation" },
          "description": "预算预留/结算条目（语义 4）：reserve → settle 两段扣费的结构化留痕；可为空数组"
        }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "step_id",
        "attempt",
        "amount_micro",
        "price_snapshot_id",
        "state",
        "settled_micro",
        "refund_micro"
      ],
      "description": "预算预留条目（语义 4 / reserve → settle）：先按 amount_micro 预扣，结算时写 settled_micro（实际用量）与 refund_micro（差额退回）。金额一律整数 micro-USD，禁浮点",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "预留 ID；**同一 step 的重试复用同一个 id**（不二次预扣）"
        },
        "step_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "amount_micro": {
          "type": "integer",
          "minimum": 0,
          "description": "预扣金额（micro-USD，整数）"
        },
        "price_snapshot_id": {
          "type": "string",
          "minLength": 1,
          "description": "价格快照 ID；**在预留生命周期内冻结**（结算不得换快照）"
        },
        "state": {
          "type": "string",
          "enum": ["held", "settled", "released", "expired"],
          "description": "预留状态：held=持有中；settled=已结算；released=主动释放；expired=失效（必须 release 并留审计）"
        },
        "settled_micro": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "实际结算金额（micro-USD）；未结算时为 null"
        },
        "refund_micro": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "退回金额（micro-USD）；未结算时为 null"
        }
      }
    },
    "status_transitions": {
      "type": "object",
      "additionalProperties": false,
      "description": "合法状态转移表；契约级元数据（挂在文档根），key 与 value 都必须落在 run.status 枚举内",
      "required": [
        "created",
        "running",
        "waiting_approval",
        "paused",
        "degraded",
        "succeeded",
        "failed",
        "cancelled",
        "outcome_unknown"
      ],
      "properties": {
        "created": { "$ref": "#/$defs/status_targets" },
        "running": { "$ref": "#/$defs/status_targets" },
        "waiting_approval": { "$ref": "#/$defs/status_targets" },
        "paused": { "$ref": "#/$defs/status_targets" },
        "degraded": { "$ref": "#/$defs/status_targets" },
        "succeeded": { "$ref": "#/$defs/status_targets" },
        "failed": { "$ref": "#/$defs/status_targets" },
        "cancelled": { "$ref": "#/$defs/status_targets" },
        "outcome_unknown": { "$ref": "#/$defs/status_targets" }
      }
    },
    "status_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "created",
          "running",
          "waiting_approval",
          "paused",
          "degraded",
          "succeeded",
          "failed",
          "cancelled",
          "outcome_unknown"
        ]
      },
      "uniqueItems": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_tier", "max_attempts", "retry_profile"],
      "properties": {
        "capability_tier": {
          "type": "string",
          "enum": ["read", "write", "destructive"],
          "description": "权限档（语义 5），能力上限；工具级 `tools[].tier` 仍独立。冲突裁决：effective_tier = min(policy.capability_tier, tool.tier)（顺序 read<write<destructive）"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "description": "重试次数上限（字段 3）"
        },
        "retry_profile": { "$ref": "#/$defs/retry_profile" }
      }
    },
    "retry_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "max_attempts", "backoff_ms", "retryable_tools"],
      "description": "分级重试的可执行细化（字段 15）：档位名之外还要写清可重试工具/上限/退避",
      "properties": {
        "name": {
          "type": "string",
          "enum": ["model_only", "read_only", "full"],
          "description": "重试档位"
        },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "backoff_ms": { "type": "integer", "minimum": 0 },
        "retryable_tools": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_steps",
        "max_tool_calls",
        "max_tokens",
        "max_cost_usd",
        "currency",
        "price_snapshot_id"
      ],
      "description": "四项配额（字段 6/16）+ 已用量；金额一律整数 micro-USD，禁浮点。max_tokens 只是 token 总量粗护栏，**不证明金额**（金额以 max_cost_usd 为准）",
      "properties": {
        "max_steps": { "type": "integer", "minimum": 0 },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "token 总量粗护栏（仅数量维度，不证明金额）"
        },
        "max_cost_usd": {
          "type": "integer",
          "minimum": 0,
          "description": "成本配额，单位 micro-USD（1 USD = 1_000_000）"
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "price_snapshot_id": {
          "type": "string",
          "minLength": 1,
          "description": "价格快照 ID（字段 16）：成本口径必须指到一份快照"
        },
        "used_steps": { "type": "integer", "minimum": 0 },
        "used_tool_calls": { "type": "integer", "minimum": 0 },
        "used_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "token 总量（粗护栏口径）"
        },
        "used_tokens_input": { "type": "integer", "minimum": 0 },
        "used_tokens_output": { "type": "integer", "minimum": 0 },
        "used_tokens_cache_read": { "type": "integer", "minimum": 0 },
        "used_tokens_cache_write": { "type": "integer", "minimum": 0 },
        "used_tokens_reasoning": { "type": "integer", "minimum": 0 },
        "used_cost_usd": { "type": "integer", "minimum": 0 }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "completed",
            "tool_error",
            "budget_exhausted",
            "deadline_exceeded",
            "approval_denied",
            "cancelled_by_caller",
            "degraded_circuit_break"
          ]
        },
        "detail": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "description": "run 级错误详情；无错时整个字段为 null（不用 code=\"none\" 哨兵）",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "tool_failed",
            "budget_exhausted",
            "deadline_exceeded",
            "approval_denied",
            "policy_violation",
            "internal_error"
          ]
        },
        "message": { "type": "string" }
      }
    },
    "audit_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "ts_ms",
        "type",
        "run_id",
        "step_id",
        "attempt",
        "payload",
        "prev_hash",
        "hash"
      ],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "ts_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "事件时间（epoch 毫秒整数）。**参与哈希**（公式里用 str(ts_ms)）"
        },
        "type": {
          "type": "string",
          "enum": [
            "run_created",
            "run_started",
            "run_finished",
            "approval_decision",
            "audit_gap",
            "side_effect_unknown",
            "tool_call",
            "tool_call_denied",
            "degraded",
            "step_started",
            "step_outcome_unknown",
            "state_transition"
          ],
          "description": "审计事件类型（**枚举只增不删**）。**v0.4 新增 `state_transition`**：状态转移留痕 —— 其 payload 必须是 $defs/state_transition_payload（见下方 allOf 约束）"
        },
        "run_id": { "type": "string", "minLength": 1 },
        "step_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "payload": { "$ref": "#/$defs/audit_payload" },
        "prev_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "state_transition" } }
          },
          "then": {
            "properties": { "payload": { "$ref": "#/$defs/state_transition_payload" } }
          }
        }
      ]
    },
    "audit_payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "审计载荷：结构化固定字段 + 可选的 extra 逃生舱（未知信息走 run/step 的其他字段）。**v0.4**：`type=state_transition` 时载荷必须是 $defs/state_transition_payload（from/to/actor/cause + 可选 evidence_ref）",
      "properties": {
        "tool": { "type": "string" },
        "args_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "**v0.5 替代 v0.4 的 `result`（自由字符串）**：结果内容的 sha256 摘要（canonical bytes 的小写 hex）。自由文本参与哈希 ⇒ 同一份结果在不同措辞下哈希不同、不可复现 ⇒ 改存 digest，原文走 `extra` 逃生舱"
        },
        "reason": { "type": "string" },
        "amount_usd": { "type": "integer", "minimum": 0 },
        "from": {
          "type": "string",
          "enum": [
            "created",
            "running",
            "waiting_approval",
            "paused",
            "degraded",
            "succeeded",
            "failed",
            "cancelled",
            "outcome_unknown"
          ],
          "description": "**仅 state_transition**：转移的源状态（v0.4）"
        },
        "to": {
          "type": "string",
          "enum": [
            "created",
            "running",
            "waiting_approval",
            "paused",
            "degraded",
            "succeeded",
            "failed",
            "cancelled",
            "outcome_unknown"
          ],
          "description": "**仅 state_transition**：转移的目标状态（v0.4）"
        },
        "actor": {
          "type": "string",
          "enum": ["control_plane", "executor", "human", "policy"],
          "description": "**仅 state_transition**：发起本次转移的主体（v0.4）"
        },
        "cause": {
          "type": "string",
          "minLength": 1,
          "description": "**仅 state_transition**：本次转移的原因（人可读，v0.4）"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "description": "**仅 state_transition**：外部对账证据引用（v0.4）。`from=outcome_unknown` 时**必填**（无证据不得离开未知态 ⇒ --replay 判红，路径 /run/audit/<i>/payload/evidence_ref）"
        },
        "extra": { "$ref": "#/$defs/extensions" }
      }
    },
    "state_transition_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "actor", "cause"],
      "description": "**v0.4**：`audit_entry.type == \"state_transition\"` 时 payload 必须是这个形状（from/to/actor/cause 四字段必填；evidence_ref 在 from=outcome_unknown 时必填，由 --replay 判据强制）",
      "properties": {
        "from": {
          "type": "string",
          "enum": [
            "created",
            "running",
            "waiting_approval",
            "paused",
            "degraded",
            "succeeded",
            "failed",
            "cancelled",
            "outcome_unknown"
          ]
        },
        "to": {
          "type": "string",
          "enum": [
            "created",
            "running",
            "waiting_approval",
            "paused",
            "degraded",
            "succeeded",
            "failed",
            "cancelled",
            "outcome_unknown"
          ]
        },
        "actor": {
          "type": "string",
          "enum": ["control_plane", "executor", "human", "policy"]
        },
        "cause": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "tool_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tier",
        "annotations",
        "args_schema",
        "side_effect",
        "dedupe_key_template",
        "result_budget_bytes"
      ],
      "description": "工具目录条目（字段 10）：按权限档过滤后才下发。**v0.5：`annotations` 必填**（MCP ToolAnnotations 折叠，见 $defs/tool_annotations）",
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "tier": {
          "type": "string",
          "enum": ["read", "write", "destructive"],
          "description": "权限档（语义 5）"
        },
        "annotations": { "$ref": "#/$defs/tool_annotations" },
        "args_schema": { "$ref": "#/$defs/args_schema" },
        "side_effect": { "$ref": "#/$defs/side_effect" },
        "dedupe_key_template": {
          "type": "string",
          "description": "工具级去重键模板（改名自 idempotency_key_template；幂等收敛 4→2 后只剩这一个模板）"
        },
        "result_budget_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "tool_annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"],
      "x-source": "MCP ToolAnnotations (spec 2025-03-26+)",
      "description": "**v0.5 新增**：工具能力注解，折叠自 MCP 的 ToolAnnotations（四个 hint 全部必填，不许省略 —— 省略即「不知道」，而消费方必须能区分「无副作用」与「不知道有没有副作用」）。**与 tier/side_effect 的映射规则写死**（CONFORMANCE §3.8）：annotations 与 tier/side_effect 不一致 ⇒ 判红（路径 `/run/tools/<i>/annotations`）",
      "properties": {
        "readOnlyHint": {
          "type": "boolean",
          "description": "工具只读、不改变环境（MCP readOnlyHint）。`true` ⇒ tier 必须是 read、side_effect 必须是 none"
        },
        "destructiveHint": {
          "type": "boolean",
          "description": "工具可能破坏性修改（MCP destructiveHint，**缺省 true**，但本契约要求显式写明）。`true` ⇒ tier 必须是 destructive"
        },
        "idempotentHint": {
          "type": "boolean",
          "description": "重复调用无额外副作用（MCP idempotentHint）。readOnlyHint=false 时：true ⇒ side_effect=idempotent，false ⇒ side_effect=non_idempotent"
        },
        "openWorldHint": {
          "type": "boolean",
          "description": "工具与开放世界交互、结果可能受外部影响（MCP openWorldHint）。**保留为 `outcome_unknown` 的预测变量**：openWorldHint=true 的工具，其非幂等调用失败时更可能落到 outcome_unknown"
        }
      }
    },
    "args_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "参数形状的粗粒度描述（不做完整 JSON Schema 求值）",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["object", "array", "string", "integer", "number", "boolean"]
        },
        "required": { "type": "array", "items": { "type": "string" } },
        "enum": { "type": "array", "items": { "type": "string" } }
      }
    },
    "side_effect": {
      "type": "string",
      "enum": ["none", "idempotent", "non_idempotent"],
      "description": "声明式副作用（字段 13）：控制面据此决定是否允许重试"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "description": "审批状态（字段 11）",
      "properties": {
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "expired"]
        },
        "by": { "type": "string" },
        "at": { "type": "string" },
        "expires_at": { "type": "string" }
      }
    },
    "granted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_at_ms", "deadline_ms", "clock"],
      "description": "控制面签发的授权（字段 4/7）：执行面只有额度，不是所有权",
      "properties": {
        "deadline_at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "绝对墙钟截止（epoch 毫秒）"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "本 step 时长上限（毫秒）"
        },
        "clock": { "$ref": "#/$defs/clock" },
        "scope": { "type": "string" },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cost_usd", "tool_calls", "tokens"],
          "properties": {
            "cost_usd": { "type": "integer", "minimum": 0 },
            "tool_calls": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "grant_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "step_id", "attempt", "dedupe_scope", "tool"],
      "description": "request_grant 入参契约（字段 18）：调用工具之前提交，控制面算 args_digest 并随 grant 回传",
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "step_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "dedupe_scope": {
          "type": ["string", "null"],
          "description": "控制面分配的去重范围（改名自 idempotency_scope）；允许 null：scope 未分配时按 run_id/step_id/tool 派生"
        },
        "tool": { "type": "string", "minLength": 1 },
        "args": { "$ref": "#/$defs/json_value" },
        "args_ref": { "type": "string" }
      }
    },
    "extensions": {
      "type": "object",
      "x-free-form": true,
      "additionalProperties": { "$ref": "#/$defs/json_value" },
      "description": "逃生舱容器：字段名与值都不限（顶层 extensions 与各 payload 的 extra）"
    },
    "json_value": {
      "description": "args 只允许 string/number/boolean/null/array/object（v0.3 起**放开浮点**：LLM 参数如 temperature=0.7 必须能表达；金额类字段仍禁浮点，见 README §3）",
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/json_value" } },
        {
          "type": "object",
          "x-free-form": true,
          "additionalProperties": { "$ref": "#/$defs/json_value" }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "attempt",
        "side_effect",
        "dedupe_scope",
        "effective_tier",
        "approval",
        "granted",
        "grant_request"
      ],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "description": "第几次尝试（字段 3）"
        },
        "side_effect": { "$ref": "#/$defs/side_effect" },
        "dedupe_scope": {
          "type": ["string", "null"],
          "description": "控制面分配的去重范围（改名自 idempotency_scope，字段 5）；允许 null。与 run.idempotency_key（业务键）是两个东西"
        },
        "effective_tier": {
          "type": "string",
          "enum": ["read", "write", "destructive"],
          "description": "本 step 的生效权限档（语义 5 冲突裁决）：必须等于 min(policy.capability_tier, tool.tier)，顺序 read<write<destructive"
        },
        "approval": { "$ref": "#/$defs/approval" },
        "args": { "$ref": "#/$defs/json_value" },
        "args_ref": {
          "type": "string",
          "minLength": 1,
          "description": "大参数引用（字段 12）；与 args 二选一"
        },
        "granted": { "$ref": "#/$defs/granted" },
        "grant_request": { "$ref": "#/$defs/grant_request" }
      },
      "oneOf": [
        {
          "required": ["args"],
          "not": { "required": ["args_ref"] }
        },
        {
          "required": ["args_ref"],
          "not": { "required": ["args"] }
        }
      ]
    }
  }
}
